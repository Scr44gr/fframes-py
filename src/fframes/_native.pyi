from collections.abc import Sequence
from pathlib import Path
from typing import final

def available_encoders() -> list[str]: ...
def lottie_info(source: str | Path) -> tuple[int, int, float]: ...

@final
class Animation:
    def sample(self, index: int, fps: int) -> float: ...
    def sample_many(self, indices: Sequence[int], fps: int) -> list[float]: ...

@final
class ColorAnimation:
    def sample(self, index: int, fps: int) -> str: ...
    def sample_many(self, indices: Sequence[int], fps: int) -> list[str]: ...

@final
class SvgVideo:
    def __len__(self) -> int: ...
    def audio_samples(self) -> bytes: ...
    def rgba(self, index: int) -> bytes: ...
    def save_png(self, index: int, path: Path) -> None: ...
    def render(
        self,
        path: Path,
        directory: Path,
        encoder: str,
        concurrency: int,
        bitrate: int = 8_000_000,
        color_matrix: str = "bt601",
    ) -> None: ...

def compile_animation(keyframes: list[tuple[float, float, float, float, str]]) -> Animation: ...
def compile_color_animation(
    keyframes: list[tuple[float, float, str, str, str]],
) -> ColorAnimation: ...
def compile_video(
    config: str, frames: Sequence[str], shaders: str = "[]", media: str = "{}"
) -> SvgVideo: ...

@final
class SceneVideo:
    def __len__(self) -> int: ...
    def rgba(self, index: int) -> bytes: ...
    def save_png(self, index: int, path: Path) -> None: ...
    def audio_samples(self) -> bytes: ...
    def render(
        self,
        path: Path,
        directory: Path,
        encoder: str,
        concurrency: int,
        bitrate: int,
        color_matrix: str = "bt601",
    ) -> None: ...

def compile_scene(plan: str) -> SceneVideo: ...

@final
class TextLayout:
    def widths(self, texts: Sequence[str], font: str) -> list[int]: ...
    def fit(self, text: str, font: str, width: int, marker: str) -> str: ...
    def wrap(self, text: str, font: str, width: int) -> list[str]: ...

def compile_text_layout(config: str) -> TextLayout: ...
def video_info(source: str) -> tuple[int, int, float, float]: ...
def image_info(source: str) -> str: ...

@final
class AudioAnalysis:
    @property
    def duration(self) -> float: ...
    @property
    def sample_rate(self) -> int: ...
    def spectrum(self, settings: str) -> bytes: ...

def decode_audio(source: str) -> AudioAnalysis: ...
def parse_subtitles(text: str) -> str: ...
def validate_path(source: str) -> None: ...

class Renderer3D:
    def rgba(self, time: float) -> bytes: ...
    def uses_gpu(self) -> bool: ...
    def project(
        self, point: tuple[float, float, float], time: float
    ) -> tuple[float, float, float] | None: ...
    def world_position(self, name: str, time: float) -> tuple[float, float, float]: ...
    def local_to_world(
        self, name: str, point: tuple[float, float, float], time: float
    ) -> tuple[float, float, float]: ...
    def world_matrix(self, name: str, time: float) -> list[float]: ...
    def bounds(self, name: str, time: float) -> tuple[list[float], list[float]] | None: ...
    def pixel_size(self, point: tuple[float, float, float], size: float, time: float) -> float: ...

def compile_3d(plan: str) -> Renderer3D: ...
def model_info(source: str) -> str: ...
def text_shapes(font: str, text: str, size: float, letter_spacing: float) -> str: ...
def inspect_video(video: SvgVideo | SceneVideo, indices: Sequence[int]) -> str: ...
def preview_video(
    video: SvgVideo | SceneVideo,
    index: int,
    path: Path,
    size: tuple[int, int] | None,
    crop: tuple[int, int, int, int] | None,
    labels: bool,
) -> None: ...
def sheet_video(
    video: SvgVideo | SceneVideo,
    indices: Sequence[int],
    path: Path,
    columns: int,
    size: tuple[int, int] | None,
    onion: bool,
) -> None: ...
def detect_pops(
    video: SvgVideo | SceneVideo, start: int, end: int, size: tuple[int, int] | None
) -> str: ...
